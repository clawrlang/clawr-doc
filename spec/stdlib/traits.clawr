trait HasStringRepresentation {
    func stringRepresentation() -> string
}

/**
 * Enable `==` and `!=` comparisons.
 * Combine with Ordered to enable `<=` and `>=`.
 */
trait Equatable {
    func equals(_ other: Self) -> boolean
}

trait HashEquatable: Equatable {
    func hash(into builder: HashBuilder)
}

opaque service HashBuilder {
    extern func add(_ value: HashEquatable)
}

extern func newHashBuilder() -> ref HashBuilder

/**
 * Enable `<` and `>` comparisons. The predicate returns true when the
 * receiver precedes the other value and false otherwise.
 * Combine with Equatable to enable `<=` and `>=`.
 */
trait Ordered {
    func isOrderedBefore(_ other: Self) -> boolean
}

extern func print(_ value: HasStringRepresentation)
