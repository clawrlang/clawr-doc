{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["*.json", "*.md", "TODO", ".prettierrc"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
